{
  "expo": {
    "name": "Lista Fácil",
    "slug": "listafacil-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "listafacil",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.listafacil.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "backgroundColor": "#EA1D2C"
      },
      "package": "com.listafacil.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Lista Fácil to access your camera for barcode scanning.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir que o Lista Fácil acesse sua localização para encontrar supermercados próximos.",
          "locationAlwaysPermission": "Permitir que o Lista Fácil acesse sua localização para encontrar supermercados próximos.",
          "locationWhenInUsePermission": "Permitir que o Lista Fácil acesse sua localização para encontrar supermercados próximos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#EA1D2C"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-image",
      "expo-status-bar",
      "./plugins/withAndroidReleaseSigning.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "af3db56d-f291-4fda-bdc0-fe47ae885170"
      }
    },
    "owner": "vitorianoernandes"
  }
}
